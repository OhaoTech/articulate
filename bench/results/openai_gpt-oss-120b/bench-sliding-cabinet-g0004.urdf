<?xml version="1.0"?>
<robot name="sliding_cabinet">

  <!-- Main cabinet body -->
  <link name="cabinet_body">
    <inertial>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
      <mass value="30.0"/>
      <inertia ixx="3.98025" ixy="0.0" ixz="0.0"
               iyy="2.66400" iyz="0.0"
               izz="4.84425"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
      <geometry>
        <box size="0.84 0.60 1.11"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
      <geometry>
        <box size="0.84 0.60 1.11"/>
      </geometry>
    </collision>
  </link>

  <!-- Left sliding door -->
  <link name="door_left">
    <inertial>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.66300" ixy="0.0" ixz="0.0"
               iyy="0.22350" iyz="0.0"
               izz="0.58690"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.60 1.11"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.60 1.11"/>
      </geometry>
    </collision>
  </link>

  <!-- Right sliding door -->
  <link name="door_right">
    <inertial>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.66300" ixy="0.0" ixz="0.0"
               iyy="0.22350" iyz="0.0"
               izz="0.58690"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.60 1.11"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.60 1.11"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint for left door (slides along X) -->
  <joint name="joint_left_door" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="door_left"/>
    <!-- Closed position: door centered at -0.21 m (half door width) -->
    <origin xyz="-0.21 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.42" upper="0.0" effort="100" velocity="0.5"/>
  </joint>

  <!-- Joint for right door (slides along X) -->
  <joint name="joint_right_door" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="door_right"/>
    <!-- Closed position: door centered at +0.21 m -->
    <origin xyz="0.21 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.42" effort="100" velocity="0.5"/>
  </joint>

</robot>
