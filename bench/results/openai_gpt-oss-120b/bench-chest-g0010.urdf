<?xml version="1.0"?>
<robot name="chest_with_lid">

  <!-- Base link: the chest body -->
  <link name="chest_body">
    <visual>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <box size="0.72 0.41 0.55"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <box size="0.72 0.41 0.55"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <inertia ixx="1.1765" ixy="0.0" ixz="0.0"
               iyy="2.0523" iyz="0.0"
               izz="1.7163"/>
    </inertial>
  </link>

  <!-- Lid link -->
  <link name="chest_lid">
    <visual>
      <origin xyz="0 -0.205 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.72 0.41 0.02"/>
      </geometry>
      <material name="brown_dark">
        <color rgba="0.4 0.2 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.205 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.72 0.41 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 -0.205 0.01" rpy="0 0 0"/>
      <inertia ixx="0.042125" ixy="0.0" ixz="0.0"
               iyy="0.1297" iyz="0.0"
               izz="0.1716"/>
    </inertial>
  </link>

  <!-- Hinge joint: rotates lid up around the back edge -->
  <joint name="lid_hinge" type="revolute">
    <parent link="chest_body"/>
    <child link="chest_lid"/>
    <!-- Joint origin at the back top edge of the chest -->
    <origin xyz="0 0.205 0.55" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10.0" velocity="1.0" lower="0.0" upper="1.5708"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

</robot>
