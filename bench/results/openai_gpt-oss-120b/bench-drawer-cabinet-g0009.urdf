<?xml version="1.0"?>
<robot name="drawer_cabinet">

  <!-- ==================== -->
  <!--   Cabinet Body Link  -->
  <!-- ==================== -->
  <link name="cabinet_body">
    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0.39" rpy="0 0 0"/>
      <geometry>
        <box size="0.43 0.50 0.78"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.39" rpy="0 0 0"/>
      <geometry>
        <box size="0.43 0.50 0.78"/>
      </geometry>
    </collision>
    <!-- Inertial (approximate solid box) -->
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.39" rpy="0 0 0"/>
      <inertia ixx="5.0" ixy="0.0" ixz="0.0"
               iyy="5.0" iyz="0.0"
               izz="2.5"/>
    </inertial>
  </link>

  <!-- ==================== -->
  <!--   Drawer 1 (top)     -->
  <!-- ==================== -->
  <link name="drawer_top">
    <visual>
      <origin xyz="0 0 0.65" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.48 0.20"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.65" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.48 0.20"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.65" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.06"/>
    </inertial>
  </link>

  <joint name="joint_top_drawer" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_top"/>
    <origin xyz="0 0 0.65" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.30" effort="100" velocity="0.2"/>
  </joint>

  <!-- ==================== -->
  <!--   Drawer 2 (middle)  -->
  <!-- ==================== -->
  <link name="drawer_middle">
    <visual>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.48 0.20"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.48 0.20"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.06"/>
    </inertial>
  </link>

  <joint name="joint_middle_drawer" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_middle"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.30" effort="100" velocity="0.2"/>
  </joint>

  <!-- ==================== -->
  <!--   Drawer 3 (bottom)  -->
  <!-- ==================== -->
  <link name="drawer_bottom">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.48 0.20"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.48 0.20"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.06"/>
    </inertial>
  </link>

  <joint name="joint_bottom_drawer" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_bottom"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.30" effort="100" velocity="0.2"/>
  </joint>

</robot>
