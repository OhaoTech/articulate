<?xml version="1.0"?>
<robot name="sliding_cabinet">

  <!-- Base cabinet body -->
  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <geometry>
        <box size="1.45 0.42 1.35"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <geometry>
        <box size="1.45 0.42 1.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <inertia ixx="5.0" ixy="0.0" ixz="0.0"
               iyy="9.8" iyz="0.0"
               izz="5.7"/>
    </inertial>
  </link>

  <!-- Left sliding door -->
  <link name="door_left">
    <visual>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <geometry>
        <box size="0.725 0.02 1.35"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <geometry>
        <box size="0.725 0.02 1.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <inertia ixx="0.76" ixy="0.0" ixz="0.0"
               iyy="0.98" iyz="0.0"
               izz="0.22"/>
    </inertial>
  </link>

  <!-- Right sliding door -->
  <link name="door_right">
    <visual>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <geometry>
        <box size="0.725 0.02 1.35"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <geometry>
        <box size="0.725 0.02 1.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <inertia ixx="0.76" ixy="0.0" ixz="0.0"
               iyy="0.98" iyz="0.0"
               izz="0.22"/>
    </inertial>
  </link>

  <!-- Joint for left door (slides along X) -->
  <joint name="joint_left_door" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="door_left"/>
    <!-- Closed position: left door centered at -0.3625 m (half cabinet width) -->
    <origin xyz="-0.3625 -0.22 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.725" upper="0.0" effort="100" velocity="0.5"/>
  </joint>

  <!-- Joint for right door (slides along X) -->
  <joint name="joint_right_door" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="door_right"/>
    <!-- Closed position: right door centered at +0.3625 m -->
    <origin xyz="0.3625 -0.22 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.725" effort="100" velocity="0.5"/>
  </joint>

</robot>
