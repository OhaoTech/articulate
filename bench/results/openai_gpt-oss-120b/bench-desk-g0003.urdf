<?xml version="1.0"?>
<robot name="desk">

  <!-- ==================== Desk Top ==================== -->
  <link name="top">
    <visual>
      <origin xyz="0 0 0.73" rpy="0 0 0"/>
      <geometry>
        <box size="1.59 0.73 0.02"/>
      </geometry>
      <material name="oak">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.73" rpy="0 0 0"/>
      <geometry>
        <box size="1.59 0.73 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <!-- Box inertia about its own center -->
      <inertia ixx="0.0011333" ixy="0.0" ixz="0.0"
               iyy="0.0181333" iyz="0.0"
               izz="0.0182667"/>
      <origin xyz="0 0 0.73" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- ==================== Legs ==================== -->
  <!-- Leg dimensions -->
  <xacro:property name="leg_width" value="0.04"/>
  <xacro:property name="leg_height" value="0.72"/>

  <!-- Front‑Left Leg -->
  <link name="leg_fl">
    <visual>
      <origin xyz="-0.775 -0.345 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_width} ${leg_width} ${leg_height}"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="-0.775 -0.345 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_width} ${leg_width} ${leg_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0012" ixy="0.0" ixz="0.0"
               iyy="0.0012" iyz="0.0"
               izz="0.0002"/>
      <origin xyz="-0.775 -0.345 0.36" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- Front‑Right Leg -->
  <link name="leg_fr">
    <visual>
      <origin xyz="0.775 -0.345 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_width} ${leg_width} ${leg_height}"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0.775 -0.345 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_width} ${leg_width} ${leg_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0012" ixy="0.0" ixz="0.0"
               iyy="0.0012" iyz="0.0"
               izz="0.0002"/>
      <origin xyz="0.775 -0.345 0.36" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- Back‑Left Leg -->
  <link name="leg_bl">
    <visual>
      <origin xyz="-0.775 0.345 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_width} ${leg_width} ${leg_height}"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="-0.775 0.345 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_width} ${leg_width} ${leg_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0012" ixy="0.0" ixz="0.0"
               iyy="0.0012" iyz="0.0"
               izz="0.0002"/>
      <origin xyz="-0.775 0.345 0.36" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- Back‑Right Leg -->
  <link name="leg_br">
    <visual>
      <origin xyz="0.775 0.345 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_width} ${leg_width} ${leg_height}"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0.775 0.345 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_width} ${leg_width} ${leg_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0012" ixy="0.0" ixz="0.0"
               iyy="0.0012" iyz="0.0"
               izz="0.0002"/>
      <origin xyz="0.775 0.345 0.36" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- Fixed joints attaching legs to the top -->
  <joint name="leg_fl_joint" type="fixed">
    <parent link="top"/>
    <child link="leg_fl"/>
    <origin xyz="-0.775 -0.345 0.0" rpy="0 0 0"/>
  </joint>
  <joint name="leg_fr_joint" type="fixed">
    <parent link="top"/>
    <child link="leg_fr"/>
    <origin xyz="0.775 -0.345 0.0" rpy="0 0 0"/>
  </joint>
  <joint name="leg_bl_joint" type="fixed">
    <parent link="top"/>
    <child link="leg_bl"/>
    <origin xyz="-0.775 0.345 0.0" rpy="0 0 0"/>
  </joint>
  <joint name="leg_br_joint" type="fixed">
    <parent link="top"/>
    <child link="leg_br"/>
    <origin xyz="0.775 0.345 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Drawer ==================== -->
  <link name="drawer">
    <visual>
      <origin xyz="0 0.15 0.55" rpy="0 0 0"/>
      <geometry>
        <box size="1.55 0.30 0.15"/>
      </geometry>
      <material name="oak">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.15 0.55" rpy="0 0 0"/>
      <geometry>
        <box size="1.55 0.30 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.01875" ixy="0.0" ixz="0.0"
               iyy="0.01875" iyz="0.0"
               izz="0.0144"/>
      <origin xyz="0 0.15 0.55" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- Prismatic joint for the drawer (slides toward -Y) -->
  <joint name="drawer_joint" type="prismatic">
    <parent link="top"/>
    <child link="drawer"/>
    <!-- Joint origin at the back inner face of the drawer when fully retracted -->
    <origin xyz="0 -0.365 0.55" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.4" effort="30" velocity="0.2"/>
    <dynamics damping="0.1" friction="0.2"/>
  </joint>

</robot>
