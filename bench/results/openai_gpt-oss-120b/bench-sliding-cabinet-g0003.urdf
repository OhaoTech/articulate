<?xml version="1.0"?>
<robot name="sliding_cabinet">

  <!-- Base cabinet body -->
  <link name="cabinet_body">
    <inertial>
      <origin xyz="0  -0.19 0.525" rpy="0 0 0"/>
      <mass value="50"/>
      <inertia ixx="5.195" ixy="0" ixz="0"
               iyy="13.361" iyz="0"
               izz="17.354"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.19 0.525" rpy="0 0 0"/>
      <geometry>
        <box size="1.75 0.38 1.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.19 0.525" rpy="0 0 0"/>
      <geometry>
        <box size="1.75 0.38 1.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Left sliding door -->
  <link name="door_left">
    <inertial>
      <origin xyz="0 0 0.525" rpy="0 0 0"/>
      <mass value="10"/>
      <inertia ixx="0.919" ixy="0" ixz="0"
               iyy="0.638" iyz="0"
               izz="1.557"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.525" rpy="0 0 0"/>
      <geometry>
        <box size="0.875 0.02 1.05"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.525" rpy="0 0 0"/>
      <geometry>
        <box size="0.875 0.02 1.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Right sliding door -->
  <link name="door_right">
    <inertial>
      <origin xyz="0 0 0.525" rpy="0 0 0"/>
      <mass value="10"/>
      <inertia ixx="0.919" ixy="0" ixz="0"
               iyy="0.638" iyz="0"
               izz="1.557"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.525" rpy="0 0 0"/>
      <geometry>
        <box size="0.875 0.02 1.05"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.525" rpy="0 0 0"/>
      <geometry>
        <box size="0.875 0.02 1.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint for left door (slides negative X) -->
  <joint name="joint_left_door" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="door_left"/>
    <origin xyz="-0.4375 -0.19 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.875" upper="0" effort="100" velocity="0.5"/>
  </joint>

  <!-- Joint for right door (slides positive X) -->
  <joint name="joint_right_door" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="door_right"/>
    <origin xyz="0.4375 -0.19 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.875" effort="100" velocity="0.5"/>
  </joint>

</robot>
