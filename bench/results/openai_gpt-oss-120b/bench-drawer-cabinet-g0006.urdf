<?xml version="1.0"?>
<robot name="drawer_cabinet">

  <!-- Base cabinet body -->
  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0 0.365" rpy="0 0 0"/>
      <geometry>
        <box size="1.03 0.56 0.73"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.365" rpy="0 0 0"/>
      <geometry>
        <box size="1.03 0.56 0.73"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.365" rpy="0 0 0"/>
      <inertia ixx="2.116" ixy="0.0" ixz="0.0"
               iyy="3.436" iyz="0.0"
               izz="3.984"/>
    </inertial>
  </link>

  <!-- Bottom drawer -->
  <link name="drawer_bottom">
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="1.03 0.55 0.22"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="1.03 0.55 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <inertia ixx="0.058" ixy="0.0" ixz="0.0"
               iyy="0.140" iyz="0.0"
               izz="0.158"/>
    </inertial>
  </link>

  <joint name="joint_bottom_drawer" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_bottom"/>
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.4" effort="100" velocity="0.2"/>
  </joint>

  <!-- Middle drawer -->
  <link name="drawer_middle">
    <visual>
      <origin xyz="0 0 0.365" rpy="0 0 0"/>
      <geometry>
        <box size="1.03 0.55 0.22"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.365" rpy="0 0 0"/>
      <geometry>
        <box size="1.03 0.55 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.365" rpy="0 0 0"/>
      <inertia ixx="0.058" ixy="0.0" ixz="0.0"
               iyy="0.140" iyz="0.0"
               izz="0.158"/>
    </inertial>
  </link>

  <joint name="joint_middle_drawer" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_middle"/>
    <origin xyz="0 0 0.365" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.4" effort="100" velocity="0.2"/>
  </joint>

  <!-- Top drawer -->
  <link name="drawer_top">
    <visual>
      <origin xyz="0 0 0.62" rpy="0 0 0"/>
      <geometry>
        <box size="1.03 0.55 0.22"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.62" rpy="0 0 0"/>
      <geometry>
        <box size="1.03 0.55 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.62" rpy="0 0 0"/>
      <inertia ixx="0.058" ixy="0.0" ixz="0.0"
               iyy="0.140" iyz="0.0"
               izz="0.158"/>
    </inertial>
  </link>

  <joint name="joint_top_drawer" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_top"/>
    <origin xyz="0 0 0.62" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.4" effort="100" velocity="0.2"/>
  </joint>

</robot>
