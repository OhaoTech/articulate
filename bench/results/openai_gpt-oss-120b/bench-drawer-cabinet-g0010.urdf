<?xml version="1.0"?>
<robot name="drawer_cabinet">

  <!-- Main cabinet body (static) -->
  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.46 1.2"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.46 1.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <inertia ixx="2.5" ixy="0.0" ixz="0.0"
               iyy="2.5" iyz="0.0"
               izz="2.5"/>
    </inertial>
  </link>

  <!-- Drawer 1 (bottom) -->
  <link name="drawer_1">
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.02"/>
    </inertial>
  </link>

  <!-- Drawer 2 -->
  <link name="drawer_2">
    <visual>
      <origin xyz="0 0 0.38" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.38" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.38" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.02"/>
    </inertial>
  </link>

  <!-- Drawer 3 -->
  <link name="drawer_3">
    <visual>
      <origin xyz="0 0 0.64" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.64" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.64" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.02"/>
    </inertial>
  </link>

  <!-- Drawer 4 -->
  <link name="drawer_4">
    <visual>
      <origin xyz="0 0 0.90" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.90" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.90" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.02"/>
    </inertial>
  </link>

  <!-- Drawer 5 (top) -->
  <link name="drawer_5">
    <visual>
      <origin xyz="0 0 1.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0 0 1.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.44 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 1.16" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.02"/>
    </inertial>
  </link>

  <!-- Sliding joints for each drawer (prismatic along -Y) -->
  <joint name="joint_drawer_1" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.3" effort="100" velocity="0.2"/>
  </joint>

  <joint name="joint_drawer_2" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_2"/>
    <origin xyz="0 0 0.38" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.3" effort="100" velocity="0.2"/>
  </joint>

  <joint name="joint_drawer_3" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_3"/>
    <origin xyz="0 0 0.64" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.3" effort="100" velocity="0.2"/>
  </joint>

  <joint name="joint_drawer_4" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_4"/>
    <origin xyz="0 0 0.90" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.3" effort="100" velocity="0.2"/>
  </joint>

  <joint name="joint_drawer_5" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_5"/>
    <origin xyz="0 0 1.16" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.3" effort="100" velocity="0.2"/>
  </joint>

</robot>
