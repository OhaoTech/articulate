<?xml version="1.0"?>
<robot name="chest_with_lid">

  <!-- Base link: the chest body -->
  <link name="chest_body">
    <visual>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.48 0.60"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.48 0.60"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <mass value="30.0"/>
      <inertia ixx="1.476" ixy="0.0" ixz="0.0"
               iyy="3.204" iyz="0.0"
               izz="2.880"/>
    </inertial>
  </link>

  <!-- Lid link -->
  <link name="chest_lid">
    <visual>
      <origin xyz="0 -0.24 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.48 0.02"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0 -0.24 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.48 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.24 0.01" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0962" ixy="0.0" ixz="0.0"
               iyy="0.3840" iyz="0.0"
               izz="0.4800"/>
    </inertial>
  </link>

  <!-- Hinge joint for the lid -->
  <joint name="lid_hinge" type="revolute">
    <!-- Joint origin at the back top edge of the chest -->
    <origin xyz="0 0.24 0.60" rpy="0 0 0"/>
    <parent link="chest_body"/>
    <child link="chest_lid"/>
    <axis xyz="1 0 0"/>
    <limit effort="100.0" velocity="1.0" lower="0.0" upper="1.5708"/>
    <dynamics damping="0.1" friction="0.2"/>
  </joint>

</robot>
