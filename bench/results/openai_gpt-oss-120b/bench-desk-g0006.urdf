<?xml version="1.0"?>
<robot name="desk">

  <!-- ==================== Desk Top ==================== -->
  <link name="top">
    <visual>
      <origin xyz="0 0 0.73" rpy="0 0 0"/>
      <geometry>
        <box size="1.34 0.64 0.02"/>
      </geometry>
      <material name="oak">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.73" rpy="0 0 0"/>
      <geometry>
        <box size="1.34 0.64 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <!-- Box inertia about its own center -->
      <inertia ixx="0.0417" ixy="0.0" ixz="0.0"
               iyy="0.0892" iyz="0.0"
               izz="0.0999"/>
      <origin xyz="0 0 0.73" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- ==================== Legs ==================== -->
  <!-- Leg dimensions: 0.04 x 0.04 x 0.70 (width x depth x height) -->
  <link name="leg_front_left">
    <visual>
      <origin xyz="-0.63 0.30 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.70"/>
      </geometry>
      <material name="metal">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.63 0.30 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.70"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.00117" ixy="0.0" ixz="0.0"
               iyy="0.00117" iyz="0.0"
               izz="0.00133"/>
      <origin xyz="-0.63 0.30 0.35" rpy="0 0 0"/>
    </inertial>
  </link>

  <joint name="leg_front_left_joint" type="fixed">
    <parent link="world"/>
    <child link="leg_front_left"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="leg_front_right">
    <visual>
      <origin xyz="0.63 0.30 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.70"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0.63 0.30 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.70"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.00117" ixy="0.0" ixz="0.0"
               iyy="0.00117" iyz="0.0"
               izz="0.00133"/>
      <origin xyz="0.63 0.30 0.35" rpy="0 0 0"/>
    </inertial>
  </link>

  <joint name="leg_front_right_joint" type="fixed">
    <parent link="world"/>
    <child link="leg_front_right"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="leg_back_left">
    <visual>
      <origin xyz="-0.63 -0.30 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.70"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="-0.63 -0.30 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.70"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.00117" ixy="0.0" ixz="0.0"
               iyy="0.00117" iyz="0.0"
               izz="0.00133"/>
      <origin xyz="-0.63 -0.30 0.35" rpy="0 0 0"/>
    </inertial>
  </link>

  <joint name="leg_back_left_joint" type="fixed">
    <parent link="world"/>
    <child link="leg_back_left"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="leg_back_right">
    <visual>
      <origin xyz="0.63 -0.30 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.70"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0.63 -0.30 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.70"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.00117" ixy="0.0" ixz="0.0"
               iyy="0.00117" iyz="0.0"
               izz="0.00133"/>
      <origin xyz="0.63 -0.30 0.35" rpy="0 0 0"/>
    </inertial>
  </link>

  <joint name="leg_back_right_joint" type="fixed">
    <parent link="world"/>
    <child link="leg_back_right"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Drawer ==================== -->
  <!-- Drawer dimensions: width 1.30 m, depth 0.30 m, height 0.15 m -->
  <link name="drawer">
    <visual>
      <origin xyz="0 0.175 0.575" rpy="0 0 0"/>
      <geometry>
        <box size="1.30 0.30 0.15"/>
      </geometry>
      <material name="metal">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.175 0.575" rpy="0 0 0"/>
      <geometry>
        <box size="1.30 0.30 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.01875" ixy="0.0" ixz="0.0"
               iyy="0.01875" iyz="0.0"
               izz="0.02500"/>
      <origin xyz="0 0.175 0.575" rpy="0 0 0"/>
    </inertial>
  </link>

  <joint name="drawer_joint" type="prismatic">
    <parent link="top"/>
    <child link="drawer"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="100" velocity="0.2" lower="0" upper="0.30"/>
  </joint>

</robot>
