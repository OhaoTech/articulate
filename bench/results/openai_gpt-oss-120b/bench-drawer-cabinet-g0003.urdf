<?xml version="1.0"?>
<robot name="drawer_cabinet">

  <!-- Main cabinet body (static) -->
  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0 0.47" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.38 0.94"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.47" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.38 0.94"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.47" rpy="0 0 0"/>
      <inertia ixx="2.5" ixy="0.0" ixz="0.0"
               iyy="2.5" iyz="0.0"
               izz="2.5"/>
    </inertial>
  </link>

  <!-- Drawer 1 (top) -->
  <link name="drawer_1">
    <visual>
      <origin xyz="0 0 0.78" rpy="0 0 0"/>
      <geometry>
        <box size="0.73 0.36 0.31"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.78" rpy="0 0 0"/>
      <geometry>
        <box size="0.73 0.36 0.31"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.78" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.02"/>
    </inertial>
  </link>

  <joint name="drawer_1_joint" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_1"/>
    <origin xyz="0 0 0.78" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.30" effort="100" velocity="0.2"/>
  </joint>

  <!-- Drawer 2 (middle) -->
  <link name="drawer_2">
    <visual>
      <origin xyz="0 0 0.47" rpy="0 0 0"/>
      <geometry>
        <box size="0.73 0.36 0.31"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.47" rpy="0 0 0"/>
      <geometry>
        <box size="0.73 0.36 0.31"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.47" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.02"/>
    </inertial>
  </link>

  <joint name="drawer_2_joint" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_2"/>
    <origin xyz="0 0 0.47" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.30" effort="100" velocity="0.2"/>
  </joint>

  <!-- Drawer 3 (bottom) -->
  <link name="drawer_3">
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.73 0.36 0.31"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.73 0.36 0.31"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.02"/>
    </inertial>
  </link>

  <joint name="drawer_3_joint" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="drawer_3"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.30" effort="100" velocity="0.2"/>
  </joint>

</robot>
