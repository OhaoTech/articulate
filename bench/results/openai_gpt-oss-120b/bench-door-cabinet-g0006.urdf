<?xml version="1.0"?>
<robot name="cabinet_with_hinged_doors">

  <!-- Base cabinet body -->
  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.98 0.59 1.88"/>
      </geometry>
      <material name="light_gray">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.98 0.59 1.88"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.94" rpy="0 0 0"/>
      <inertia ixx="9.706" ixy="0.0" ixz="0.0"
               iyy="11.237" iyz="0.0"
               izz="3.271"/>
    </inertial>
  </link>

  <!-- Left door -->
  <link name="left_door">
    <visual>
      <origin xyz="-0.245 -0.305 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.49 0.02 1.88"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.245 -0.305 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.49 0.02 1.88"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="-0.245 -0.305 0.94" rpy="0 0 0"/>
      <inertia ixx="1.473" ixy="0.0" ixz="0.0"
               iyy="1.573" iyz="0.0"
               izz="0.100"/>
    </inertial>
  </link>

  <!-- Right door -->
  <link name="right_door">
    <visual>
      <origin xyz="0.245 -0.305 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.49 0.02 1.88"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.245 -0.305 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.49 0.02 1.88"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0.245 -0.305 0.94" rpy="0 0 0"/>
      <inertia ixx="1.473" ixy="0.0" ixz="0.0"
               iyy="1.573" iyz="0.0"
               izz="0.100"/>
    </inertial>
  </link>

  <!-- Joint for left door -->
  <joint name="left_door_joint" type="revolute">
    <parent link="cabinet_body"/>
    <child link="left_door"/>
    <origin xyz="0 -0.295 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="1.0" lower="-1.57" upper="0.0"/>
  </joint>

  <!-- Joint for right door -->
  <joint name="right_door_joint" type="revolute">
    <parent link="cabinet_body"/>
    <child link="right_door"/>
    <origin xyz="0 -0.295 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="1.0" lower="0.0" upper="1.57"/>
  </joint>

</robot>
