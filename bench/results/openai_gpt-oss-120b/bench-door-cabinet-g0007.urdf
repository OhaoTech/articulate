<?xml version="1.0"?>
<robot name="cabinet_with_one_hinged_door">

  <!-- Cabinet body -->
  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0 0.49" rpy="0 0 0"/>
      <geometry>
        <box size="0.47 0.55 0.98"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.49" rpy="0 0 0"/>
      <geometry>
        <box size="0.47 0.55 0.98"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.49" rpy="0 0 0"/>
      <inertia ixx="3.1573" ixy="0.0" ixz="0.0"
               iyy="2.9533" iyz="0.0"
               izz="1.3085"/>
    </inertial>
  </link>

  <!-- Door -->
  <link name="door">
    <visual>
      <!-- Door visual is centered relative to its own frame -->
      <origin xyz="0.235 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.47 0.02 0.98"/>
      </geometry>
      <material name="brown">
        <color rgba="0.4 0.2 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.235 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.47 0.02 0.98"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0.235 0 0" rpy="0 0 0"/>
      <inertia ixx="0.4003" ixy="0.0" ixz="0.0"
               iyy="0.4922" iyz="0.0"
               izz="0.0922"/>
    </inertial>
  </link>

  <!-- Hinge joint -->
  <joint name="door_hinge" type="revolute">
    <!-- Joint origin is at the left vertical edge of the cabinet front face -->
    <origin xyz="-0.235 -0.275 0.49" rpy="0 0 0"/>
    <parent link="cabinet_body"/>
    <child link="door"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="1.0" lower="0.0" upper="1.5708"/>
    <dynamics damping="0.1" friction="0.2"/>
  </joint>

</robot>
