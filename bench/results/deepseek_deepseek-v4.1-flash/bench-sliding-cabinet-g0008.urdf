<?xml version="1.0"?>
<robot name="sliding_door_cabinet">
  <material name="wood">
    <color rgba="0.65 0.45 0.25 1.0"/>
  </material>
  <material name="door_wood">
    <color rgba="0.75 0.55 0.35 1.0"/>
  </material>

  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0.025 0.93" rpy="0 0 0"/>
      <geometry>
        <box size="1.33 0.45 1.86"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0 0.025 0.93" rpy="0 0 0"/>
      <geometry>
        <box size="1.33 0.45 1.86"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.025 0.93" rpy="0 0 0"/>
      <mass value="60.0"/>
      <inertia ixx="18.31" ixy="0.0" ixz="0.0" iyy="26.14" iyz="0.0" izz="9.857"/>
    </inertial>
  </link>

  <link name="rear_door">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.70 0.02 1.80"/>
      </geometry>
      <material name="door_wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.70 0.02 1.80"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="4.8606" ixy="0.0" ixz="0.0" iyy="5.595" iyz="0.0" izz="0.7356"/>
    </inertial>
  </link>

  <link name="front_door">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.70 0.02 1.80"/>
      </geometry>
      <material name="door_wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.70 0.02 1.80"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="4.8606" ixy="0.0" ixz="0.0" iyy="5.595" iyz="0.0" izz="0.7356"/>
    </inertial>
  </link>

  <joint name="rear_door_joint" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="rear_door"/>
    <origin xyz="-0.315 -0.215 0.93" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.63" effort="50.0" velocity="0.5"/>
  </joint>

  <joint name="front_door_joint" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="front_door"/>
    <origin xyz="0.315 -0.24 0.93" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.63" upper="0.0" effort="50.0" velocity="0.5"/>
  </joint>
</robot>
