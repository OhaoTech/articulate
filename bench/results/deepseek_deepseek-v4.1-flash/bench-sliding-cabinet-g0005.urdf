<?xml version="1.0"?>
<robot name="sliding_door_cabinet">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0.03 0.675" rpy="0 0 0"/>
      <mass value="40"/>
      <inertia ixx="6.507" ixy="0" ixz="0" iyy="7.440" iyz="0" izz="13.083"/>
    </inertial>
    <visual>
      <origin xyz="0 0.03 0.675" rpy="0 0 0"/>
      <geometry>
        <box size="1.45 0.36 1.35"/>
      </geometry>
      <material name="wood">
        <color rgba="0.6 0.4 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.03 0.675" rpy="0 0 0"/>
      <geometry>
        <box size="1.45 0.36 1.35"/>
      </geometry>
    </collision>
  </link>

  <link name="left_door">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="1.1269" ixy="0" ixz="0" iyy="0.3753" iyz="0" izz="1.5017"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.02 1.30"/>
      </geometry>
      <material name="glass">
        <color rgba="0.7 0.8 0.9 0.5"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.02 1.30"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_door_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="left_door"/>
    <origin xyz="-0.35 -0.17 0.675" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.72" effort="50" velocity="0.5"/>
  </joint>

  <link name="right_door">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="1.1269" ixy="0" ixz="0" iyy="0.3753" iyz="0" izz="1.5017"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.02 1.30"/>
      </geometry>
      <material name="glass">
        <color rgba="0.7 0.8 0.9 0.5"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.02 1.30"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_door_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="right_door"/>
    <origin xyz="0.35 -0.20 0.675" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.72" upper="0" effort="50" velocity="0.5"/>
  </joint>
</robot>
