<robot name="sliding_cabinet">
  <link name="cabinet_body">
    <inertial>
      <origin xyz="0 0.02 0.545" rpy="0 0 0"/>
      <mass value="30"/>
      <inertia ixx="3.242500" ixy="0" ixz="0" iyy="2.252500" iyz="0" izz="4.950500"/>
    </inertial>
    <visual>
      <origin xyz="0 0.02 0.545" rpy="0 0 0"/>
      <geometry>
        <box size="0.89 0.33 1.09"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.02 0.545" rpy="0 0 0"/>
      <geometry>
        <box size="0.89 0.33 1.09"/>
      </geometry>
    </collision>
  </link>

  <link name="door_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.495208" ixy="0" ixz="0" iyy="0.082677" iyz="0" izz="0.577552"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.445 0.02 1.09"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.445 0.02 1.09"/>
      </geometry>
    </collision>
  </link>

  <link name="door_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.495208" ixy="0" ixz="0" iyy="0.082677" iyz="0" izz="0.577552"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.445 0.02 1.09"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.445 0.02 1.09"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_door_joint" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="door_left"/>
    <origin xyz="-0.2225 -0.175 0.545" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.445" effort="10" velocity="0.5"/>
  </joint>

  <joint name="right_door_joint" type="prismatic">
    <parent link="cabinet_body"/>
    <child link="door_right"/>
    <origin xyz="0.2225 -0.155 0.545" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.445" upper="0" effort="10" velocity="0.5"/>
  </joint>
</robot>
