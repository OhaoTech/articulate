<robot name="cabinet">
  <link name="cabinet_body">
    <inertial>
      <origin xyz="0 0 0.385" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="1.254833" ixy="0.0" ixz="0.0" iyy="1.310833" iyz="0.0" izz="0.589333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.385" rpy="0 0 0"/>
      <geometry>
        <box size="0.44 0.40 0.77"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.385" rpy="0 0 0"/>
      <geometry>
        <box size="0.44 0.40 0.77"/>
      </geometry>
    </collision>
  </link>

  <link name="door">
    <inertial>
      <origin xyz="0.22 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.247208" ixy="0.0" ixz="0.0" iyy="0.327708" iyz="0.0" izz="0.080833"/>
    </inertial>
    <visual>
      <origin xyz="0.22 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.44 0.02 0.77"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.22 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.44 0.02 0.77"/>
      </geometry>
    </collision>
  </link>

  <joint name="door_hinge" type="revolute">
    <parent link="cabinet_body"/>
    <child link="door"/>
    <origin xyz="-0.22 -0.21 0.385" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="0.0" effort="10.0" velocity="1.0"/>
  </joint>
</robot>
