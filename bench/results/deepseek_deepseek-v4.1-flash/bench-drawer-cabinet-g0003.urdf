    <child link="drawer_1"/>
    <origin xyz="0 -0.181 0.1687" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.35" effort="150.0" velocity="0.4"/>
    <dynamics damping="2.0" friction="1.0"/>
  </joint>

