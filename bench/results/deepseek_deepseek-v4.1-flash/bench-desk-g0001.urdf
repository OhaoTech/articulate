  </link>

  <link name="drawer_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="0.2167" ixy="0" ixz="0" iyy="1.3217" iyz="0" izz="1.5083"/>
