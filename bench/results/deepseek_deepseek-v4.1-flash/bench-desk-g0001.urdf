  <joint name="drawer_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_link"/>
    <origin xyz="0 0 0.575" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.4" effort="50" velocity="0.5"/>
