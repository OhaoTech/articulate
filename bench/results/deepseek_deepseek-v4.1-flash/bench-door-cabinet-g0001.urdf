<robot name="cabinet">
  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0.01 0.475" rpy="0 0 0"/>
      <geometry>
        <box size="0.91 0.34 0.95"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.01 0.475" rpy="0 0 0"/>
      <geometry>
        <box size="0.91 0.34 0.95"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.01 0.475" rpy="0 0 0"/>
      <mass value="30"/>
      <inertia ixx="2.54525" ixy="0" ixz="0" iyy="2.35925" iyz="0" izz="4.3265"/>
    </inertial>
  </link>

  <link name="left_door">
    <visual>
      <origin xyz="0.2275 -0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.455 0.02 0.95"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.2275 -0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.455 0.02 0.95"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.2275 -0.01 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.376208" ixy="0" ixz="0" iyy="0.086427" iyz="0" izz="0.462302"/>
    </inertial>
  </link>

  <link name="right_door">
    <visual>
      <origin xyz="-0.2275 -0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.455 0.02 0.95"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.2275 -0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.455 0.02 0.95"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.2275 -0.01 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.376208" ixy="0" ixz="0" iyy="0.086427" iyz="0" izz="0.462302"/>
    </inertial>
  </link>

  <joint name="left_door_joint" type="revolute">
    <parent link="cabinet_body"/>
    <child link="left_door"/>
    <origin xyz="-0.455 -0.16 0.475" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <joint name="right_door_joint" type="revolute">
    <parent link="cabinet_body"/>
    <child link="right_door"/>
    <origin xyz="0.455 -0.16 0.475" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
</robot>
