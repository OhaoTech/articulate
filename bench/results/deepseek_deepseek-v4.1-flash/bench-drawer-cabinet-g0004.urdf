    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.4" effort="50" velocity="0.3"/>
  </joint>

  <!-- Drawer 2 -->
  <link name="drawer_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
