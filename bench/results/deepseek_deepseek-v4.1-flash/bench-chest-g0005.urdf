<?xml version="1.0"?>
<robot name="chest">
  <link name="chest_body">
    <visual>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.48 0.55"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.48 0.55"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.8881667" ixy="0" ixz="0" iyy="2.0401667" iyz="0" izz="1.92"/>
    </inertial>
  </link>

  <link name="lid">
    <visual>
      <origin xyz="0 -0.24 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.48 0.05"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.24 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.48 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.24 0.025" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0970417" ixy="0" ixz="0" iyy="0.3850417" iyz="0" izz="0.48"/>
    </inertial>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="chest_body"/>
    <child link="lid"/>
    <origin xyz="0 0.24 0.55" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.5708" effort="100" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
</robot>
