<?xml version="1.0"?>
<robot name="chest">
  <link name="chest_body">
    <inertial>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <mass value="20"/>
      <inertia ixx="0.5535" ixy="0" ixz="0" iyy="0.8790" iyz="0" izz="0.7575"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry>
        <box size="0.57 0.36 0.45"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry>
        <box size="0.57 0.36 0.45"/>
      </geometry>
    </visual>
  </link>

  <link name="lid">
    <inertial>
      <origin xyz="0 -0.18 0.025" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.0550417" ixy="0" ixz="0" iyy="0.1364167" iyz="0" izz="0.189375"/>
    </inertial>
    <collision>
      <origin xyz="0 -0.18 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.57 0.36 0.05"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 -0.18 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.57 0.36 0.05"/>
      </geometry>
    </visual>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="chest_body"/>
    <child link="lid"/>
    <origin xyz="0 0.18 0.45" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
</robot>
