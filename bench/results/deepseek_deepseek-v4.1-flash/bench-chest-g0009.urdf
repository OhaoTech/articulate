<robot name="chest">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.2125" ixy="0.0" ixz="0.0" iyy="0.6085" iyz="0.0" izz="0.5650"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.26 0.32"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.26 0.32"/>
      </geometry>
    </collision>
  </link>

  <link name="lid_link">
    <inertial>
      <origin xyz="0 -0.13 0.02" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.028833" ixy="0.0" ixz="0.0" iyy="0.160833" iyz="0.0" izz="0.188333"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.13 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.26 0.04"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.13 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.26 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="lid_link"/>
    <origin xyz="0 0.13 0.32" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="0.0" effort="30.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
</robot>
