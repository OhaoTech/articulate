<?xml version="1.0"?>
<robot name="drawer_cabinet">

  <material name="wood"><color rgba="0.60 0.40 0.20 1.0"/></material>
  <material name="wood_light"><color rgba="0.78 0.62 0.42 1.0"/></material>
  <material name="metal"><color rgba="0.55 0.55 0.60 1.0"/></material>

  <!-- ================= CABINET CARCASS ================= -->
  <link name="cabinet">
    <inertial>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <mass value="30.0"/>
      <inertia ixx="4.129" ixy="0.0" ixz="0.0"
               iyy="4.225" iyz="0.0"
               izz="1.154"/>
    </inertial>

    <!-- left side panel -->
    <collision>
      <origin xyz="-0.24 0 0.6" rpy="0 0 0"/>
      <geometry><box size="0.02 0.46 1.20"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.24 0 0.6" rpy="0 0 0"/>
      <geometry><box size="0.02 0.46 1.20"/></geometry>
      <material name="wood"/>
    </visual>

    <!-- right side panel -->
    <collision>
      <origin xyz="0.24 0 0.6" rpy="0 0 0"/>
      <geometry><box size="0.02 0.46 1.20"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.24 0 0.6" rpy="0 0 0"/>
      <geometry><box size="0.02 0.46 1.20"/></geometry>
      <material name="wood"/>
    </visual>

    <!-- top panel -->
    <collision>
      <origin xyz="0 0 1.19" rpy="0 0 0"/>
      <geometry><box size="0.50 0.46 0.02"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 1.19" rpy="0 0 0"/>
      <geometry><box size="0.50 0.46 0.02"/></geometry>
      <material name="wood"/>
    </visual>

    <!-- bottom panel -->
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.50 0.46 0.02"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.50 0.46 0.02"/></geometry>
      <material name="wood"/>
    </visual>

    <!-- back panel -->
    <collision>
      <origin xyz="0 0.22 0.6" rpy="0 0 0"/>
      <geometry><box size="0.46 0.02 1.16"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0.22 0.6" rpy="0 0 0"/>
      <geometry><box size="0.46 0.02 1.16"/></geometry>
      <material name="wood"/>
    </visual>
  </link>

  <!-- ================= DRAWER 1 ================= -->
  <link name="drawer_1">
    <inertial>
      <origin xyz="0 0.15 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.0562" ixy="0.0" ixz="0.0"
               iyy="0.0650" iyz="0.0"
               izz="0.0970"/>
    </inertial>
    <collision>
      <origin xyz="0 0.01 0" rpy="0 0 0"/>
      <geometry><box size="0.46 0.02 0.22"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0.01 0" rpy="0 0 0"/>
      <geometry><box size="0.46 0.02 0.22"/></geometry>
      <material name="wood_light"/>
    </visual>
    <collision>
      <origin xyz="0 0.22 0" rpy="0 0 0"/>
      <geometry><box size="0.44 0.40 0.18"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0.22 0" rpy="0 0 0"/>
      <geometry><box size="0.44 0.40 0.18"/></geometry>
      <material name="wood_light"/>
    </visual>
    <visual>
      <origin xyz="0 0.005 0" rpy="0 0 0"/>
      <geometry><box size="0.20 0.02 0.03"/></geometry>
      <material name="metal"/>
    </visual>
  </link>

  <joint name="drawer_1_joint" type="prismatic">
    <parent link="cabinet"/>
    <child link="drawer_1"/>
    <origin xyz="0 -0.23 0.136" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.40" effort="200.0" velocity="0.5"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>

  <!-- ================= DRAWER 2 ================= -->
