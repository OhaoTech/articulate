<robot name="chest">
  <link name="body">
    <inertial>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <mass value="20"/>
      <inertia ixx="0.6262" ixy="0" ixz="0" iyy="1.8928" iyz="0" izz="2.1337"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry>
        <box size="1.01 0.51 0.34"/>
      </geometry>
      <material name="brown">
        <color rgba="0.55 0.27 0.07 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry>
        <box size="1.01 0.51 0.34"/>
      </geometry>
    </collision>
  </link>

  <link name="lid">
    <inertial>
      <origin xyz="0 -0.255 0.015" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.10875" ixy="0" ixz="0" iyy="0.4254" iyz="0" izz="0.5334"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.255 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="1.01 0.51 0.03"/>
      </geometry>
      <material name="dark_brown">
        <color rgba="0.35 0.15 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.255 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="1.01 0.51 0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="body"/>
    <child link="lid"/>
    <origin xyz="0 0.255 0.34" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.57" effort="10" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
</robot>
