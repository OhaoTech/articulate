<?xml version="1.0"?>
<robot name="cabinet">
  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0 0.295" rpy="0 0 0"/>
      <geometry>
        <box size="0.67 0.47 0.59"/>
      </geometry>
      <material name="wood">
        <color rgba="0.6 0.4 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.295" rpy="0 0 0"/>
      <geometry>
        <box size="0.67 0.47 0.59"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.295" rpy="0 0 0"/>
      <mass value="20"/>
      <inertia ixx="0.9483" ixy="0" ixz="0" iyy="1.3283" iyz="0" izz="1.1163"/>
    </inertial>
  </link>

  <link name="door">
    <visual>
      <origin xyz="0.335 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.67 0.02 0.59"/>
      </geometry>
      <material name="wood">
        <color rgba="0.6 0.4 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.335 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.67 0.02 0.59"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.335 0 0" rpy="0 0 0"/>
      <mass value="3"/>
      <inertia ixx="0.087125" ixy="0" ixz="0" iyy="0.19925" iyz="0" izz="0.112325"/>
    </inertial>
  </link>

  <joint name="door_hinge" type="revolute">
    <parent link="cabinet_body"/>
    <child link="door"/>
    <origin xyz="-0.335 -0.245 0.295" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="0" effort="10" velocity="1.0"/>
  </joint>
</robot>
