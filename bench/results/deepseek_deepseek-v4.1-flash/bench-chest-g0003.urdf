<robot name="chest">
  <link name="chest_body">
    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="25.0"/>
      <inertia ixx="0.790833" ixy="0.0" ixz="0.0" iyy="2.401042" iyz="0.0" izz="2.150208"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.95 0.36 0.50"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.95 0.36 0.50"/>
      </geometry>
    </collision>
  </link>

  <link name="chest_lid">
    <inertial>
      <origin xyz="0 -0.18 0.05" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.093067" ixy="0.0" ixz="0.0" iyy="0.608333" iyz="0.0" izz="0.688067"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.18 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.95 0.36 0.10"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.18 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.95 0.36 0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="chest_body"/>
    <child link="chest_lid"/>
    <origin xyz="0 0.18 0.50" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="1.5708" effort="100.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
</robot>
