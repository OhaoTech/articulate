<?xml version="1.0"?>
<robot name="cabinet">
  <material name="wood">
    <color rgba="0.6 0.4 0.2 1.0"/>
  </material>
  <material name="door">
    <color rgba="0.7 0.5 0.3 1.0"/>
  </material>

  <link name="cabinet_body">
    <visual>
      <origin xyz="0 0.15 0.92" rpy="0 0 0"/>
      <geometry>
        <box size="1.01 0.30 1.84"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0 0.15 0.92" rpy="0 0 0"/>
      <geometry>
        <box size="1.01 0.30 1.84"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.15 0.92" rpy="0 0 0"/>
      <mass value="40"/>
      <inertia ixx="11.585" ixy="0" ixz="0" iyy="14.686" iyz="0" izz="3.700"/>
    </inertial>
  </link>

  <link name="left_door">
    <visual>
      <origin xyz="0.2525 -0.01 0.92" rpy="0 0 0"/>
      <geometry>
        <box size="0.505 0.02 1.84"/>
      </geometry>
      <material name="door"/>
    </visual>
    <collision>
      <origin xyz="0.2525 -0.01 0.92" rpy="0 0 0"/>
      <geometry>
        <box size="0.505 0.02 1.84"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.2525 -0.01 0.92" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="1.4108" ixy="0" ixz="0" iyy="1.5169" iyz="0" izz="0.10643"/>
    </inertial>
  </link>

  <joint name="left_door_hinge" type="revolute">
    <parent link="cabinet_body"/>
    <child link="left_door"/>
    <origin xyz="-0.505 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="0" effort="20" velocity="2"/>
  </joint>

  <link name="right_door">
    <visual>
      <origin xyz="-0.2525 -0.01 0.92" rpy="0 0 0"/>
      <geometry>
        <box size="0.505 0.02 1.84"/>
      </geometry>
      <material name="door"/>
    </visual>
    <collision>
      <origin xyz="-0.2525 -0.01 0.92" rpy="0 0 0"/>
      <geometry>
        <box size="0.505 0.02 1.84"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.2525 -0.01 0.92" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="1.4108" ixy="0" ixz="0" iyy="1.5169" iyz="0" izz="0.10643"/>
    </inertial>
  </link>

  <joint name="right_door_hinge" type="revolute">
    <parent link="cabinet_body"/>
    <child link="right_door"/>
    <origin xyz="0.505 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="20" velocity="2"/>
  </joint>
</robot>
