<?xml version="1.0"?>
<robot name="desk">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.627" rpy="0 0 0"/>
      <mass value="21"/>
      <inertia ixx="1.667" ixy="0" ixz="0" iyy="4.361" iyz="0" izz="4.265"/>
    </inertial>

    <!-- Table top -->
    <visual>
      <origin xyz="0 0 0.695" rpy="0 0 0"/>
      <geometry>
        <box size="1.41 0.67 0.03"/>
      </geometry>
      <material name="wood">
        <color rgba="0.6 0.4 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.695" rpy="0 0 0"/>
      <geometry>
        <box size="1.41 0.67 0.03"/>
      </geometry>
    </collision>

    <!-- Front right leg -->
    <visual>
      <origin xyz="0.63 -0.26 0.34" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.68"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0.63 -0.26 0.34" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.68"/>
      </geometry>
    </collision>

    <!-- Front left leg -->
    <visual>
      <origin xyz="-0.63 -0.26 0.34" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.68"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="-0.63 -0.26 0.34" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.68"/>
      </geometry>
    </collision>

    <!-- Back right leg -->
    <visual>
      <origin xyz="0.63 0.26 0.34" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.68"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0.63 0.26 0.34" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.68"/>
      </geometry>
    </collision>

    <!-- Back left leg -->
    <visual>
      <origin xyz="-0.63 0.26 0.34" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.68"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="-0.63 0.26 0.34" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.68"/>
      </geometry>
    </collision>
  </link>

  <link name="drawer_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3"/>
      <inertia ixx="0.0681" ixy="0" ixz="0" iyy="0.4225" iyz="0" izz="0.3656"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.5 0.15"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.5 0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="drawer_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_link"/>
    <origin xyz="0 -0.05 0.605" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.4" effort="50" velocity="0.5"/>
  </joint>
</robot>
