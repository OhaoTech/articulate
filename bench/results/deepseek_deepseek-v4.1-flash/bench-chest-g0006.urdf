<robot name="chest">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.085" rpy="0 0 0"/>
      <mass value="30.0"/>
      <inertia ixx="0.378500" ixy="0" ixz="0" iyy="2.881250" iyz="0" izz="3.115250"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.085" rpy="0 0 0"/>
      <geometry>
        <box size="1.06 0.35 0.17"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.085" rpy="0 0 0"/>
      <geometry>
        <box size="1.06 0.35 0.17"/>
      </geometry>
      <material name="wood">
        <color rgba="0.6 0.4 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <link name="lid_link">
    <inertial>
      <origin xyz="0 -0.175 0.015" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.051417" ixy="0" ixz="0" iyy="0.468542" iyz="0" izz="0.519208"/>
    </inertial>
    <collision>
      <origin xyz="0 -0.175 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="1.06 0.35 0.03"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 -0.175 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="1.06 0.35 0.03"/>
      </geometry>
      <material name="wood">
        <color rgba="0.6 0.4 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="lid_link"/>
    <origin xyz="0 0.175 0.17" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="1.57" effort="100.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
</robot>
