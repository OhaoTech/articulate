<?xml version="1.0"?>
<robot name="sliding_door_cabinet">
  <material name="wood">
    <color rgba="0.6 0.4 0.2 1.0"/>
  </material>
  <material name="door_wood">
    <color rgba="0.7 0.5 0.3 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0.02 0.775" rpy="0 0 0"/>
      <mass value="40.0"/>
      <inertia ixx="8.9097" ixy="0" ixz="0" iyy="14.1737" iyz="0" izz="7.0667"/>
    </inertial>
    <visual>
      <origin xyz="0 0.02 0.775" rpy="0 0 0"/>
      <geometry>
        <box size="1.36 0.52 1.55"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0 0.02 0.775" rpy="0 0 0"/>
      <geometry>
        <box size="1.36 0.52 1.55"/>
      </geometry>
    </collision>
  </link>

  <link name="door_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="1.5609" ixy="0" ixz="0" iyy="1.8689" iyz="0" izz="0.3085"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.68 0.02 1.53"/>
      </geometry>
      <material name="door_wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.68 0.02 1.53"/>
      </geometry>
    </collision>
  </link>

  <link name="door_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="1.5609" ixy="0" ixz="0" iyy="1.8689" iyz="0" izz="0.3085"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.68 0.02 1.53"/>
      </geometry>
      <material name="door_wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.68 0.02 1.53"/>
      </geometry>
    </collision>
  </link>

  <joint name="door_left_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="door_left"/>
    <origin xyz="-0.34 -0.25 0.775" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.68" effort="50.0" velocity="0.5"/>
  </joint>

  <joint name="door_right_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="door_right"/>
    <origin xyz="0.34 -0.27 0.775" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.68" upper="0.0" effort="50.0" velocity="0.5"/>
  </joint>
</robot>
