<?xml version="1.0"?>
<robot name="cabinet">
  <material name="wood">
    <color rgba="0.6 0.4 0.2 1.0"/>
  </material>
  <material name="door">
    <color rgba="0.7 0.5 0.3 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0.01 0.94" rpy="0 0 0"/>
      <mass value="45"/>
      <inertia ixx="14.4724" ixy="0" ixz="0" iyy="16.8555" iyz="0" izz="4.8199"/>
    </inertial>
    <visual>
      <origin xyz="0 0.01 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.98 0.57 1.88"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0 0.01 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.98 0.57 1.88"/>
      </geometry>
    </collision>
  </link>

  <link name="left_door">
    <inertial>
      <origin xyz="0.245 -0.01 0.94" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="2.3565" ixy="0" ixz="0" iyy="2.5163" iyz="0" izz="0.1603"/>
    </inertial>
    <visual>
      <origin xyz="0.245 -0.01 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.49 0.02 1.88"/>
      </geometry>
      <material name="door"/>
    </visual>
    <collision>
      <origin xyz="0.245 -0.01 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.49 0.02 1.88"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_door_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="left_door"/>
    <origin xyz="-0.49 -0.275 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="0" effort="10" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="right_door">
    <inertial>
      <origin xyz="-0.245 -0.01 0.94" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="2.3565" ixy="0" ixz="0" iyy="2.5163" iyz="0" izz="0.1603"/>
    </inertial>
    <visual>
      <origin xyz="-0.245 -0.01 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.49 0.02 1.88"/>
      </geometry>
      <material name="door"/>
    </visual>
    <collision>
      <origin xyz="-0.245 -0.01 0.94" rpy="0 0 0"/>
      <geometry>
        <box size="0.49 0.02 1.88"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_door_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="right_door"/>
    <origin xyz="0.49 -0.275 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
</robot>
