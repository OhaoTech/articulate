<robot name="chest">
  <link name="chest_body">
    <inertial>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <mass value="60.0"/>
      <inertia ixx="1.853" ixy="0.0" ixz="0.0" iyy="3.6045" iyz="0.0" izz="3.4325"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry>
        <box size="0.72 0.41 0.45"/>
      </geometry>
      <material name="wood">
        <color rgba="0.55 0.27 0.07 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry>
        <box size="0.72 0.41 0.45"/>
      </geometry>
    </collision>
  </link>

  <link name="chest_lid">
    <inertial>
      <origin xyz="0 -0.205 0.05" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.222625" ixy="0.0" ixz="0.0" iyy="0.6605" iyz="0.0" izz="0.858125"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.205 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.72 0.41 0.10"/>
      </geometry>
      <material name="wood">
        <color rgba="0.55 0.27 0.07 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.205 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.72 0.41 0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="chest_body"/>
    <child link="chest_lid"/>
    <origin xyz="0 0.205 0.45" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="0.0" effort="100.0" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>
</robot>
