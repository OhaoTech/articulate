<?xml version="1.0"?>
<robot name="desk">
  <material name="wood">
    <color rgba="0.6 0.4 0.2 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="17.2"/>
      <origin xyz="0 0 0.6301"/>
      <inertia ixx="1.64334" ixy="0" ixz="0" iyy="2.19397" iyz="0" izz="2.32524"/>
    </inertial>

    <!-- Tabletop -->
    <visual>
      <origin xyz="0 0 0.745"/>
      <geometry>
        <box size="0.84 0.67 0.03"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.745"/>
      <geometry>
        <box size="0.84 0.67 0.03"/>
      </geometry>
    </collision>

    <!-- Leg 1: front right -->
    <visual>
      <origin xyz="0.375 -0.29 0.365"/>
      <geometry>
        <box size="0.05 0.05 0.73"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0.375 -0.29 0.365"/>
      <geometry>
        <box size="0.05 0.05 0.73"/>
      </geometry>
    </collision>

    <!-- Leg 2: front left -->
    <visual>
      <origin xyz="-0.375 -0.29 0.365"/>
      <geometry>
        <box size="0.05 0.05 0.73"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="-0.375 -0.29 0.365"/>
      <geometry>
        <box size="0.05 0.05 0.73"/>
      </geometry>
    </collision>

    <!-- Leg 3: back right -->
    <visual>
      <origin xyz="0.375 0.29 0.365"/>
      <geometry>
        <box size="0.05 0.05 0.73"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0.375 0.29 0.365"/>
      <geometry>
        <box size="0.05 0.05 0.73"/>
      </geometry>
    </collision>

    <!-- Leg 4: back left -->
    <visual>
      <origin xyz="-0.375 0.29 0.365"/>
      <geometry>
        <box size="0.05 0.05 0.73"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="-0.375 0.29 0.365"/>
      <geometry>
        <box size="0.05 0.05 0.73"/>
      </geometry>
    </collision>
  </link>

  <link name="drawer">
    <inertial>
      <mass value="3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.068125" ixy="0" ixz="0" iyy="0.128125" iyz="0" izz="0.185"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.7 0.5 0.15"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.7 0.5 0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="drawer_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer"/>
    <origin xyz="0 -0.085 0.655"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.4" effort="50" velocity="0.5"/>
  </joint>
</robot>
