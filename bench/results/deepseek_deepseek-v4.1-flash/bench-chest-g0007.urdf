<?xml version="1.0"?>
<robot name="chest">
  <link name="base_link">
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <inertia ixx="0.75725" ixy="0" ixz="0" iyy="1.38125" iyz="0" izz="0.8885"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.23 0.50"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.23 0.50"/>
      </geometry>
      <material name="brown">
        <color rgba="0.5 0.3 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <link name="lid_link">
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 -0.115 0.015" rpy="0 0 0"/>
      <inertia ixx="0.01345" ixy="0" ixz="0" iyy="0.07585" iyz="0" izz="0.08885"/>
    </inertial>
    <collision>
      <origin xyz="0 -0.115 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.23 0.03"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 -0.115 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.23 0.03"/>
      </geometry>
      <material name="brown"/>
    </visual>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="lid_link"/>
    <origin xyz="0 0.115 0.50" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="2.0" effort="10.0" velocity="1.0"/>
  </joint>
</robot>
