<robot name="chest">
  <link name="chest_body">
    <inertial>
      <origin xyz="0 0 0.215" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.5488333" ixy="0.0" ixz="0.0" iyy="0.6456667" iyz="0.0" izz="0.5781667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.215" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.38 0.43"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.215" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.38 0.43"/>
      </geometry>
    </collision>
  </link>

  <link name="lid">
    <inertial>
      <origin xyz="0 -0.19 0.05" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0643333" ixy="0.0" ixz="0.0" iyy="0.0885417" iyz="0.0" izz="0.1445417"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.19 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.38 0.10"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.19 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.38 0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="chest_body"/>
    <child link="lid"/>
    <origin xyz="0 0.19 0.43" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="0.0" effort="50.0" velocity="2.0"/>
  </joint>
</robot>
