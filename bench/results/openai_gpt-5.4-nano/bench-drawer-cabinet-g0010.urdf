<robot name="drawer_cabinet_0p5m_0p46m_1p2m">
  <!-- Units: metres, radians -->
  <!-- Origin: on floor, under middle of the object. X across width, Y toward back (front faces -Y), Z up. -->
  <!-- Cabinet outer dimensions: W=0.50 (X), H=1.20 (Z), D=0.46 (Y) -->
  <!-- Assumptions -->
  <!-- - Outer shell thickness: 0.02 m (sides/bottom/back/front frame) -->
  <!-- - Each drawer has: front panel thickness 0.018 m, box depth 0.420 m (inside cavity), side thickness 0.012 m, bottom thickness 0.008 m -->
  <!-- - Drawer clearances and track length implied by sliding front-out -->
  <!-- - Drawer motion modeled by prismatic joints along +X? NO: drawers slide toward front along -Y -->
  <!-- Drawer stack: 5 drawers equally spaced in Z -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.60" rpy="0 0 0"/>
      <mass value="45.0"/>
      <inertia ixx="0.30" iyy="0.50" izz="0.25" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.60" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.46 1.20"/>
      </geometry>
      <material name="cabinet_body">
        <color rgba="0.60 0.55 0.50 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.60" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.46 1.20"/>
      </geometry>
    </collision>
  </link>

  <!-- Drawer links -->
  <!-- Drawer internal vertical span per drawer: 1.20/5 = 0.24 m -->
  <!-- We'll place each drawer box center at: z = (k+0.5)*0.24 for k=0..4 -->
  <!-- Drawer boxes sit within cabinet; for collision simplicity, model drawer volume as a slightly inset box -->
  <!-- Drawer slide: joint axis along -Y (front). Use prismatic with axis 0 -1 0. -->
  <!-- Drawer extents: x from -0.245..+0.245 (0.49 wide) for inner fit -->
  <!-- Drawer depth box: 0.42 in Y, centered relative to cabinet front/back cavity -->
  <!-- Cabinet cavity depth approx: 0.46 - 0.02(bottom back/front frame thickness) - 0.02(back thickness) = 0.42 -->
  <!-- Put drawer box center at y = -0.245? Let's define cabinet origin at center of depth (Y=0 in middle). -->
  <!-- Cabinet extends in Y: [-0.23, +0.23]. Front is at -0.23. -->
  <!-- Drawer box should sit mostly inside cavity near front/back frame: place center at y = 0.0 initially so it fits across cavity. -->
  <!-- For sliding, we implement joint offset. Drawer initial position corresponds to drawers fully closed. -->
  <!-- Choose closed drawer box center at y = 0.0 + (frontInset) = -0.03 (so most is inside, some protrusion minimal). -->
  <!-- Provide slide range to reach about 0.20 m outwards toward -Y -->
  <!-- Let closed joint position = 0, opened joint max = 0.20 m. With axis 0 -1 0, positive joint moves along -Y (front). -->
  <!-- Therefore drawer link origins are at closed position y=-0.03, then move further -Y with q*axis. -->

  <!-- Drawer geometry constants -->
  <!-- Drawer box sizes (for collision/visual) -->
  <!-- width: 0.476 m (0.50 - 2*0.012 side clearance + slight inset); depth: 0.420 m; height: 0.232 m -->
  <!-- height per drawer: 0.24; leave top/bottom rails 0.004 each => 0.232 -->
  <!-- front panel included as a thin plate? We'll include only box for simplicity while still "real" collision; add front plate as separate collision in drawer link. -->

  <!-- Drawer 1 (bottom) -->
  <link name="drawer_1_link">
    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <mass value="7.5"/>
      <inertia ixx="0.0200" iyy="0.0300" izz="0.0200" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
      <material name="drawer_box">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.03-0.420/2+0.009 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
      <material name="drawer_front">
        <color rgba="0.30 0.30 0.30 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.03 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.03-0.420/2+0.009 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
    </collision>
  </link>

  <!-- Drawer 2 -->
  <link name="drawer_2_link">
    <inertial>
      <origin xyz="0 0 0.36" rpy="0 0 0"/>
      <mass value="7.5"/>
      <inertia ixx="0.0200" iyy="0.0300" izz="0.0200" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
      <material name="drawer_box">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.03-0.420/2+0.009 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
      <material name="drawer_front">
        <color rgba="0.30 0.30 0.30 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.03 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.03-0.420/2+0.009 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
    </collision>
  </link>

  <!-- Drawer 3 -->
  <link name="drawer_3_link">
    <inertial>
      <origin xyz="0 0 0.60" rpy="0 0 0"/>
      <mass value="7.5"/>
      <inertia ixx="0.0200" iyy="0.0300" izz="0.0200" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03 0.60" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
      <material name="drawer_box">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.03-0.420/2+0.009 0.60" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
      <material name="drawer_front">
        <color rgba="0.30 0.30 0.30 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.03 0.60" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.03-0.420/2+0.009 0.60" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
    </collision>
  </link>

  <!-- Drawer 4 -->
  <link name="drawer_4_link">
    <inertial>
      <origin xyz="0 0 0.84" rpy="0 0 0"/>
      <mass value="7.5"/>
      <inertia ixx="0.0200" iyy="0.0300" izz="0.0200" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03 0.84" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
      <material name="drawer_box">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.03-0.420/2+0.009 0.84" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
      <material name="drawer_front">
        <color rgba="0.30 0.30 0.30 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.03 0.84" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.03-0.420/2+0.009 0.84" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
    </collision>
  </link>

  <!-- Drawer 5 (top) -->
  <link name="drawer_5_link">
    <inertial>
      <origin xyz="0 0 1.08" rpy="0 0 0"/>
      <mass value="7.5"/>
      <inertia ixx="0.0200" iyy="0.0300" izz="0.0200" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03 1.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
      <material name="drawer_box">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.03-0.420/2+0.009 1.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
      <material name="drawer_front">
        <color rgba="0.30 0.30 0.30 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.03 1.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.420 0.232"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.03-0.420/2+0.009 1.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.476 0.018 0.232"/>
      </geometry>
    </collision>
  </link>

  <!-- Joints (prismatic) -->
  <!-- Joint frames: placed at drawer closed center position so that q=0 gives the link at those coordinates. -->
  <!-- Axis 0 -1 0: positive q moves toward front (-Y). -->
  <joint name="drawer_1_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_1_link"/>
    <origin xyz="0 -0.03 0.12" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.20" effort="50" velocity="1.0"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <joint name="drawer_2_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_2_link"/>
    <origin xyz="0 -0.03 0.36" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.20" effort="50" velocity="1.0"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <joint name="drawer_3_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_3_link"/>
    <origin xyz="0 -0.03 0.60" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.20" effort="50" velocity="1.0"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <joint name="drawer_4_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_4_link"/>
    <origin xyz="0 -0.03 0.84" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.20" effort="50" velocity="1.0"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <joint name="drawer_5_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="drawer_5_link"/>
    <origin xyz="0 -0.03 1.08" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.20" effort="50" velocity="1.0"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

</robot>
