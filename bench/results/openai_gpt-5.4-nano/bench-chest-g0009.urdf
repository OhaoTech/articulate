<robot name="chest_with_lid">
  <link name="base">
    <inertial>
      <origin xyz="0 0.0 0.1305" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.040" ixy="0.0" ixz="0.0" iyy="0.020" iyz="0.0" izz="0.040"/>
    </inertial>
    <visual>
      <origin xyz="0 0.0 0.1305" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.26 0.26"/>
      </geometry>
      <material name="wood_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0.0 0.1305" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.26 0.26"/>
      </geometry>
    </collision>
  </link>

  <link name="lid">
    <inertial>
      <origin xyz="0 -0.13 0.26" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.025" iyz="0.0" izz="0.025"/>
    </inertial>

    <visual>
      <origin xyz="0 0.13 0.26" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.26 0.04"/>
      </geometry>
      <material name="wood_light"/>
    </visual>
    <collision>
      <origin xyz="0 0.13 0.26" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.26 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="lid_hinge" type="revolute">
    <parent link="base"/>
    <child link="lid"/>
    <origin xyz="0 -0.13 0.26" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="50" velocity="2.0"/>
  </joint>
</robot>
